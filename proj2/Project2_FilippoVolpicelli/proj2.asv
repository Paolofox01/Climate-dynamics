%%

function dcds = continuation_rhs_new(para, basis)
    lambda = para(1);
    x = para(2);
    y = para(3);

    R = 2;
    del = 1/6;
    f = (R * x - y) / lambda;
    absf = abs(f);
    sgnf = sign(f);

    df_dlambda = sgnf * (R*x - y) * x / lambda^2;
    df_dx = -del - absf - sgnf*R*x / lambda;
    df_dy = sgnf*x / lambda;
    
    df_djk = basis\[df_dx; df_dy];

    u = [df_dlambda; df_djk(1); df_djk(2)];

    dg_dlambda = sgnf * (R*x - y) * y / lambda^2;
    dg_dx = -y * sgnf * R / lambda;
    dg_dy = -1 - absf + y * sgnf / lambda;

    dg_djk = basis\[dg_dx; dg_dy];

    v = [dg_dlambda; dg_djk(1); dg_djk(2)];

    tangent = cross(u, v);
    dcds = tangent / norm(tangent);
end

lambda0 = 0.2;

s = linspace(0, 0.5, 1000);


function dydt = ode2(t, y)
   dydt = [3*y(1) - 2*y(2); 2*y(1) + 3*y(2)];
end



[t,y] = ode45(@ode2,[0 1],[1; 1]);



function sol = sol2(t, c)
   sol = [c(1).*exp(3.*t).*(-sin(2.*t)) + c(2).*exp(3.*t).*(cos(2.*t)); c(1).*exp(3.*t).*(cos(2.*t)) + c(2).*exp(3.*t).*(sin(2.*t))];
end

temp = linspace(0,1,45);
c=[1;1];


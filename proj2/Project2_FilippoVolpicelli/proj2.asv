function dydt = ode3(t, y)
   dydt = [y(1) + y(2); -1*y(1) + 3*y(2)];
end

[t,y] = ode45(@ode3,[0 1],[0; 1]);



function sol = sol3(t, c)
   sol = [c(1).*exp(2.*t)-c(2).*exp(2.*t) + c(2).*t.*exp(2.*t); c(1).*exp(2.*t) + t.*c(2).*exp(2.*t)];
end


function dcds = continuation_rhs_bonus(para)
    lambda = para(1);
    x = para(2);
    y = para(3);

    R = 2;
    del = 1/6;
    f = (R * x - y) / lambda;
    absf = abs(f);
    sgnf = sign(f);

    df_dlambda = sgnf * (R*x - y) * x / lambda^2;
    df_dx = -del - absf - sgnf*R*x / lambda;
    df_dy = sgnf*x / lambda;
    u = [df_dlambda; df_dx; df_dy];

    dg_dlambda = sgnf * (R*x - y) * y / lambda^2;
    dg_dx = -y * sgnf * R / lambda;
    dg_dy = -1 - absf + y * sgnf / lambda;
    v = [dg_dlambda; dg_dx; dg_dy];

    tangent = cross(u, v);
    dcds = tangent / norm(tangent);
end

lambda0 = 0.2;


%% radice
x=0.129;
y=0.485;

del = 1/6;
lam = 0.2;
R=2;

n = 1000;


for i = 1:n
    f = (R*x - y) / lam;
    
    F1 = del*(1-x) - abs(f)*x;
    F2 = (1 - y) - abs(f)*y;

    J = [ -del - abs(f) - (x*R/lam) * sign(f),  x/lam * sign(f);
          -y*R/lam * sign(f),  -1 - abs(f) + (y/lam) * sign(f) ];
    
    d = -J \ [F1; F2];
    
    x = x + d(1);
    y = y + d(2);
    
  
end


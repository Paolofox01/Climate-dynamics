solutions = {csol, csol2, csol3,psol,psol2,psol3};




hold on
for sol = 1:length(solutions)
    
    for i = 1:1000
        
        lambda=solutions{sol}(i,1);
        x=solutions{sol}(i,2);
        y=solutions{sol}(i,3);
        R = 2;
        del = 1/6;
    
        f = (R * x - y) / lambda;
        absf = abs(f);
        sgnf = sign(f);
    
        df_dx = -del - absf - sgnf*R*x / lambda;
        df_dy = sgnf*x / lambda;
    
        dg_dx = -y * sgnf * R / lambda;
        dg_dy = -1 - absf + y * sgnf / lambda;

        mattt = [df_dx, df_dy; dg_dx, dg_dy];
        
        subplot(1,2,1)
        hold on

        if all(eig(mattt)<0) 
            plot(solutions{sol}(i,1), solutions{sol}(i,2),' b.')
        else
            plot(solutions{sol}(i,1), solutions{sol}(i,2), ' r.')
        end

        subplot(1,2,2)
        hold on

        if all(eig(mattt)<0) 
            plot(solutions{sol}(i,1), solutions{sol}(i,3),' b.')
        else
            plot(solutions{sol}(i,1), solutions{sol}(i,3), ' r.')
        end
    end
end


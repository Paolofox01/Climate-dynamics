function stom = stomf(t, para)
    del = 1/6;
    lam = 0.2;
    R=2;
    X=para(1);
    Y=para(2);
    f=(R.*X - Y)./lam;
    
    stom = [del*(1-X) - abs(f).*X; (1-Y) - abs(f).*Y]; 
end

[~,y1] = ode45(@stomf,[0 -10],[a2; b2] + eps*double(V(:,2)));
[~,y2] = ode45(@stomf,[0 -10],[a2; b2] - eps*double(V(:,2)));
[~,y3] = ode45(@stomf,[0 100],[a2; b2] + eps*double(V(:,1)));
[~,y4] = ode45(@stomf,[0 100],[a2; b2] - eps*double(V(:,1)));





function dydt = ode1(t, y)
   dydt = [4*y(1) - y(2); 2*y(1) + y(2)];
end



[t,y] = ode45(@ode1,[0 1],[2; 3]);



function sol = sol1(t, c)
   sol = [c(1).*exp(3.*t) + c(2).*exp(2.*t); c(1).*exp(3.*t) + 2.*c(2).*exp(2.*t)];
end

temp = linspace(0,1,45);
c=[1;1];

sol = sol1(temp, c);

figure;
subplot(1, 2, 1);
hold on 

